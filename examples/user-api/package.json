{
  "name": "@better-back/example-user-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node ../../packages/core/dist/bin.js build",
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts",
    "routes": "node ../../packages/core/dist/bin.js routes src/app.module.ts",
    "graph": "node ../../packages/core/dist/bin.js graph src/app.module.ts",
    "openapi": "node ../../packages/core/dist/bin.js openapi src/app.module.ts --out openapi.json",
    "doctor": "node ../../packages/core/dist/bin.js doctor --verify-app",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "better-back": "*",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "morgan": "^1.12.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^20.19.43"
  }
}
